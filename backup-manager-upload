# Amazon S3 Mode
##############################################################
# {{{

# List every key of an S3 bucket.
# list() returns at most 1000 keys per call; list_all() follows the markers
# until the whole bucket is listed. Net::Amazon::S3 releases lacking
# list_all() are paged by hand.
# Returns a reference to the array of keys, or (undef, reason) if the
# listing failed.
sub s3_list_keys($)
{
    my ($bucket) = @_;
    if ($bucket->can('list_all')) {
        my $response = eval { $bucket->list_all };
        return (undef, $@) unless defined $response
                              and ref $response eq 'HASH'
                              and ref $response->{keys} eq 'ARRAY';
        return $response->{keys};
    }

    my @keys;
    my $marker;
    while (1) {
        my $response = eval {
            $bucket->list(defined $marker ? { marker => $marker } : {});
        };
        return (undef, $@) unless defined $response
                              and ref $response eq 'HASH'
                              and ref $response->{keys} eq 'ARRAY';
        push @keys, @{$response->{keys}};
        last unless $response->{is_truncated} and @{$response->{keys}};
        $marker = $response->{next_marker} || $response->{keys}[-1]{key};
    }
    return \@keys;
}

# Return a readable description of the last S3 error: the exception thrown
# by Net::Amazon::S3 if any, its err/errstr otherwise.
sub s3_error_string($$)
{
    my ($s3, $exception) = @_;
    if (defined $exception and length $exception) {
        chomp $exception;
        return $exception;
    }
    my $err = $s3->can('err') ? $s3->err : undef;
    my $errstr = $s3->can('errstr') ? $s3->errstr : undef;
    return join(': ', grep { defined and length } ($err, $errstr))
        || 'unknown error';
}

# Function for purging a directory
# from S3, the same way as the repository is purged.
# Every files with a date field too old according to BM_ARCHIVE_TTL
# will be deleted.
sub s3_clean_directory($)
{
    my ($bucket) = @_;
    my $BM_ARCHIVE_TTL = $ENV{BM_ARCHIVE_TTL};
    if (defined $ENV{BM_UPLOAD_S3_TTL} and
        length ($ENV{BM_UPLOAD_S3_TTL})) {
        $BM_ARCHIVE_TTL = $ENV{BM_UPLOAD_S3_TTL};
    }
    return 0 unless defined $BM_ARCHIVE_TTL;
    my $date_to_remove = `date +%Y%m%d --date "$BM_ARCHIVE_TTL days ago"`;
    chomp $date_to_remove;

    my ($ra_keys, $list_error) = s3_list_keys($bucket);
    unless (defined $ra_keys) {
        chomp $list_error if defined $list_error;
        print_error "Unable to list the keys of the bucket, cannot purge it: "
                  . ($list_error || 'unknown error');
        return 0;
    }
    my @keys = @{$ra_keys};

    foreach my $key (@keys) {
    my $date = undef;
    if ($key->{key} =~ /[\.\-](\d{8})\./) {
        $date = $1;
        if ($date and ($date <= $date_to_remove)) {
        print_info $key->{key} . " has to be deleted, too old ($date <= $date_to_remove).";
                $bucket->delete_key( $key->{key} );
        }
    }
    }
    return 1;
}

# Returns the last error reported by Net::Amazon::S3, readable by a human:
# the message followed by the S3 error code, when both are known.
sub __s3_errstr($)
{
    my ($s3) = @_;
    my $code = $s3->err;
    my $msg  = $s3->errstr;
    $code = undef unless defined $code and length $code;
    $msg  = undef unless defined $msg and length $msg;
    return "$msg ($code)" if defined $msg and defined $code and $msg ne $code;
    return $msg  if defined $msg;
    return $code if defined $code;
    return 'unknown error';
}

# Returns the bucket object for $name.
sub __s3_bucket($$)
{
    my ($s3, $name) = @_;
    return $s3->bucket($name);
}

# How to upload files to s3.
# We'll use the Net::Amazon::S3 module here.
sub send_files_with_s3($$$$$$)
{
    # trying to get Net::Amazon::S3.
    eval "use Net::Amazon::S3";
    if ($@) {
        print_error "Net::Amazon::S3 is not available, cannot use S3 service : $@";
        return FALSE;
    }

    if ($Net::Amazon::S3::VERSION < '0.39') {
        print_error "Net::Amazon::S3 >= 0.39 is required, but version ${Net::Amazon::S3::VERSION} was found, cannot use S3 service";
        return FALSE;
    }

    # getting args
    my ($user, $passwd, $bucket, $ra_hosts, $repository, $ra_files) = @_;

    unless (defined $user and 
        defined $passwd and
        defined $bucket and
        defined $ra_hosts and
        defined $ra_files and
        defined $repository) {
        print_error "required args needed";
        return FALSE;
    }

    my $totalbytes = 0;
    my $starttime = time();
    my $success = TRUE;
    my $backup_bucket;

    # loop on each hosts given and connect to them.
    foreach my $host (@{$ra_hosts}) {
        # key name => size of every key sent to this host
        my %uploaded;
        # [archive, [its keys]] for every archive fully sent to this host
        my @sent_files;
        my $s3 = Net::Amazon::S3->new(
            {   
                aws_access_key_id => $user,
                aws_secret_access_key => $passwd,
                timeout => 300
            }
        );

        unless (defined $s3) {
            print_error "Unable to connect to $host : $@\n";
            return FALSE;
        }

        print_info "Connected to $host";

        my $bucket_obj = __s3_bucket($s3, $bucket);

        my $response = $bucket_obj->list;

        if (not ($response and $response->{bucket})) {
            my $err = $s3->err;
            # Older Net::Amazon::S3 versions may set no error code at all
            # on a missing bucket: keep trying to create it in that case.
            if (defined $err and length $err and $err ne 'NoSuchBucket') {
                print_error "Cannot access bucket $bucket: " . __s3_errstr($s3)
                    . " (if the bucket lives outside us-east-1, set BM_UPLOAD_S3_REGION)";
                return FALSE;
            }
            print_info "Bucket $bucket does not exist... creating";
            unless ($s3->add_bucket({ bucket => $bucket })) {
                print_error "Could not create bucket $bucket: " . __s3_errstr($s3);
                return FALSE;
            }
            $bucket_obj = __s3_bucket($s3, $bucket);
        }

        s3_clean_directory($bucket_obj) if ($g_s3clean);

        foreach my $file (@{$ra_files}) {
            chomp $file;
            my @splits = $file;
            my $is_split = FALSE;
            if( stat($file)->size > $g_s3max_size ) {
                my $split_prefix = "$file-split-";
                my $cmd = "$split -b $g_s3max_size " . shell_quote($file) . " " . shell_quote($split_prefix);
                $is_split = TRUE;
                if( system($cmd) != 0 ) {
                    print_error "Could not run '$cmd' to split $file into chunks of size $g_s3max_size";
                    # remove any partial chunks left behind by split
                    unlink bsd_glob(glob_escape($split_prefix) . "*");
                    $success = FALSE;
                    next;
                } else {
                    @splits = bsd_glob(glob_escape($split_prefix) . "*");
                }
            }

            my @file_keys;
            my $file_uploaded = TRUE;
            for my $split (@splits) {
                my $filename = basename($split);
                my $file_length = stat($split)->size;

                print_info "opened $split of length $file_length and will name the key $filename";

                # Depending on its version, Net::Amazon::S3 either returns
                # false or dies when the upload fails: handle both.
                my $added = eval {
                    $bucket_obj->add_key_filename(
                        $filename, $split,
                        {
                            content_type => "application/binary"
                        }
                    );
                };
                unless ($added) {
                    print_error "Unable to upload $split to bucket $bucket on $host: "
                              . s3_error_string($s3, $@);
                    $file_uploaded = FALSE;
                    last;
                }
                $totalbytes += $file_length;
                $uploaded{$filename} = $file_length;
                push @file_keys, $filename;
            }
            # The chunks are only temporary copies of the original archive,
            # which is kept: remove them to avoid wasting disk space.
            if ($is_split) {
                foreach my $split (@splits) {
                    unlink $split
                        or print_warning "Unable to remove chunk $split: $!";
                }
            }
            if ($file_uploaded) {
                push @sent_files, [$file, \@file_keys];
            }
            else {
                # Not recorded as uploaded, so the next run retries it.
                $success = FALSE;
            }
        }

        # Get the list of keys from the bucket and confirm the uploads.
        my %confirmed;
        my ($ra_keys, $list_error) = s3_list_keys($bucket_obj);
        if (not defined $ra_keys) {
            # Nothing can be confirmed, so nothing gets recorded.
            print_error "Unable to list the keys of bucket $bucket on $host, "
                      . "cannot confirm the uploads: " . s3_error_string($s3, $list_error);
            $success = FALSE;
            $ra_keys = [];
            %uploaded = ();
        }
        foreach my $key (@{$ra_keys}) {
            if (not defined $uploaded{$key->{key}}) {
                next;
            }
            if ($key->{size} == $uploaded{$key->{key}}) {
                print_info $key->{key} . " uploaded sucessfully";
                $confirmed{$key->{key}} = TRUE;
            }
            else {
                print_error $key->{key} . " did not upload sucessfully. S3 reports $key is " . $key->{size} . " bytes rather than " . $uploaded{$key->{key}};
                $success = FALSE;
            }
            delete $uploaded{$key->{key}};
        }
        # Whatever is left was sent but is missing from the bucket.
        foreach my $key (sort keys %uploaded) {
            print_error "$key did not upload sucessfully. It is missing from bucket $bucket on $host";
            $success = FALSE;
        }

        # Only archives whose every key is confirmed are recorded as uploaded.
        foreach my $sent (@sent_files) {
            my ($file, $ra_file_keys) = @{$sent};
            if (not grep { not $confirmed{$_} } @{$ra_file_keys}) {
                appendto_uploaded_archives($file, $host);
            }
        }
    }

    print_info ("Uploaded $totalbytes bytes of data to S3 in " 
             .  (time() - $starttime) . " seconds");
    return $success;
}

